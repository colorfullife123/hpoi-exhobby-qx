[Rule]
DOMAIN-SUFFIX,adintl.cn,REJECT
DOMAIN,api-dsp.8ziben.com,REJECT
DOMAIN,bid.buluken.com,REJECT
DOMAIN-SUFFIX,fancyapi.com,REJECT
DOMAIN,wcp.taobao.com,REJECT
DOMAIN,qzs.gdtimg.com,REJECT
DOMAIN,ad.toutiao.com,REJECT
DOMAIN-SUFFIX,zhangyuyidong.cn,REJECT
DOMAIN-SUFFIX,hardcoresir.net,REJECT
DOMAIN,guanggao-prod.cn-shanghai.log.aliyuncs.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN-SUFFIX,beizi.biz,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN-SUFFIX,66mobi.com,REJECT
DOMAIN-SUFFIX,litemob.net,REJECT
DOMAIN-SUFFIX,bayescom.com,REJECT
DOMAIN-SUFFIX,xdmssp.com,REJECT
DOMAIN-SUFFIX,adbiding.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao1.com,REJECT
DOMAIN-SUFFIX,pangolin-sdk-toutiao-b.com,REJECT
DOMAIN,pangolin.snssdk.com,REJECT
DOMAIN-SUFFIX,pglstatp-toutiao.com,REJECT
DOMAIN-SUFFIX,pglstatp-snssdk-toutiao.com,REJECT

[Url Rewrite]
^http://www\.exhobby\.net/(.*) 307 https://www.exhobby.net/$1
^https://www\.hpoi\.net\.cn/api/hobby/amazonPrice(?:\?|$) reject-dict
^https://www\.hpoi\.net\.cn/api/goods/tb/[^?]+(?:\?|$) reject-dict
^https://rfx\.hpoi\.net/[^?]*__exhobby__/cover-v3\.2\.png[^?]*(?:\?.*)?$ 302 https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/assets/exhobby-cover-v3.2.png
^https://rfx\.hpoi\.net/[^?]*__exhobby__/([^?]+)(?:\?.*)?$ 302 https://res.e39x.com/pic/n/$1

[Script]
http-response ^https://www\.hpoi\.net\.cn/api/common/advert/list(?:\?|$) script-path=https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-ad-sanitize-v3.7.1.js,requires-body=true,timeout=10,tag=HPOI 启动广告净化,enable=true
http-response ^https://www\.exhobby\.net/__hpoi_cache_(?:status|clear)__(?:\?.*)?$ script-path=https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js,requires-body=true,timeout=10,tag=EXHOBBY 缓存页面,enable=true
http-response ^https://www\.exhobby\.net/picture(?:\?|/\d+(?:\?|$)) script-path=https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js,requires-body=true,timeout=15,tag=EXHOBBY 会话捕获,enable=true
http-request ^https://www\.hpoi\.net\.cn/api/(?:item/get|hobby/album|album/detail|pic/list/relate-v2)(?:\?|$) script-path=https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js,requires-body=true,timeout=15,tag=HPOI EXHOBBY 请求,enable=true
http-response ^https://www\.hpoi\.net\.cn/api/(?:item/get|hobby/album|album/detail|pic/list/relate-v2)(?:\?|$) script-path=https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js,requires-body=true,timeout=15,tag=HPOI EXHOBBY 响应,enable=true

[MITM]
hostname = www.hpoi.net.cn, rfx.hpoi.net, www.exhobby.net
