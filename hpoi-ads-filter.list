# HPOI startup-ad filter rules for Quantumult X
# Updated 2026-09-18 for cold-start compatibility.
# Keep HPOI's own advert/product API handling in rewrite, because hpoi.net.cn also serves normal app APIs.
# Do not reject hpoi.net.cn, rfx.hpoi.net, img.alicdn.com, user.jpush.cn, or umeng.com.
# Keep HPOI's own API and image hosts direct so a catch-all proxy rule cannot break cold launch.

host-suffix, hpoi.net.cn, direct
host-suffix, hpoi.net, direct

# Original HPOI ad endpoints
host-suffix, adintl.cn, reject
host, api-dsp.8ziben.com, reject
host, bid.buluken.com, reject

# FancyAPI / Taobao ad chain
host-suffix, fancyapi.com, reject
host, wcp.taobao.com, reject
host, qzs.gdtimg.com, reject
host, ad.toutiao.com, reject

# ZYSDK2 chain captured from HPOI on 2026-09-16
host-suffix, zhangyuyidong.cn, reject
host-suffix, hardcoresir.net, reject
host, guanggao-prod.cn-shanghai.log.aliyuncs.com, reject

# Tencent / fallback ad SDK endpoints
host-suffix, gdt.qq.com, reject
host-suffix, beizi.biz, reject
host, sdk.e.qq.com, reject
host-suffix, 66mobi.com, reject
host-suffix, litemob.net, reject
host-suffix, bayescom.com, reject
host-suffix, xdmssp.com, reject
host-suffix, adbiding.com, reject

# Pangolin fallback endpoints
host-suffix, pangolin-sdk-toutiao.com, reject
host-suffix, pangolin-sdk-toutiao1.com, reject
host-suffix, pangolin-sdk-toutiao-b.com, reject
host, pangolin.snssdk.com, reject
host-suffix, pglstatp-toutiao.com, reject
host-suffix, pglstatp-snssdk-toutiao.com, reject
