# Hpoi EXHOBBY v3.7.2 - Quantumult X remote rewrite
# Keeps one explicit Hpoi official startup record without touching sibling fields.
# Cold-start compatibility revision: 2026-09-27.1
# Assumes branch main and hpoi-exhobby.js at the repository root.
# Confirm that the script URL is publicly accessible before enabling.
# Disable the previous local Hpoi EXHOBBY/ad rules when enabling this resource.

hostname = www.hpoi.net.cn, rfx.hpoi.net, www.exhobby.net

# HPOI official startup advertising
# Keep one explicitly identifiable official record; preserve all other response fields and arrays.
# Unknown response structures pass through. Third-party domains remain rejected by hpoi-ads-filter.list.
^https://www\.hpoi\.net\.cn/api/common/advert/list(?:\?|$) url script-response-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-ad-sanitize-v3.7.2.js

# Hide Taobao-related products below item details while keeping normal item data and image CDNs untouched.
^https://www\.hpoi\.net\.cn/api/hobby/amazonPrice(?:\?|$) url reject-dict

# Current HPOI builds fetch Taobao cards from /api/goods/tb/more-v2; clear only the Taobao goods API family.
^https://www\.hpoi\.net\.cn/api/goods/tb/[^?]+(?:\?|$) url reject-dict

# Do not MITM third-party ad SDK hosts or answer them with an empty HTTP 200.
# Some SDK cold-start paths treat an empty successful response as valid data and crash while parsing it.
# Block those hosts at the filter layer with hpoi-ads-filter.list instead.

# EXHOBBY native-album integration
# Cache status. Open https://www.exhobby.net/__hpoi_cache_status__ in Safari.
^https://www\.exhobby\.net/__hpoi_cache_status__(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js
# Manual cache cleanup. Open https://www.exhobby.net/__hpoi_cache_clear__ in Safari.
^https://www\.exhobby\.net/__hpoi_cache_clear__(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js
# Some older Safari/EXHOBBY combinations still open gallery links over HTTP.
# 307 preserves POST and its pagination body while upgrading transport security.
^http://www\.exhobby\.net/(.*) url 307 https://www.exhobby.net/$1
^https://www\.exhobby\.net/picture(?:\?|/\d+(?:\?|$)) url script-response-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js
^https://www\.hpoi\.net\.cn/api/(?:item/get|hobby/album|album/detail|pic/list/relate-v2)(?:\?|$) url script-request-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js
^https://www\.hpoi\.net\.cn/api/(?:item/get|hobby/album|album/detail|pic/list/relate-v2)(?:\?|$) url script-response-body https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/hpoi-exhobby-v3.7.0.js
# Legacy v3.4.1 cache compatibility only; v3.4.3 no longer inserts this cover.
^https://rfx\.hpoi\.net/[^?]*__exhobby__/cover-v3\.2\.png[^?]*(?:\?.*)?$ url 302 https://raw.githubusercontent.com/colorfullife123/hpoi-exhobby-qx/main/assets/exhobby-cover-v3.2.png
^https://rfx\.hpoi\.net/[^?]*__exhobby__/([^?]+)(?:\?.*)?$ url 302 https://res.e39x.com/pic/n/$1
